1	@ 3600 IN A 192.0.2.1
2	www 300 IN A 192.0.2.2
3	www 900 IN AAAA 2001:db8::1
4	alias 1800 IN CNAME www.example.com.
5	apexalias 3600 IN CNAME example.com.
6	ext 3600 IN CNAME target.example.net.
7	@ 86400 IN ALIAS lb.example.net.
8	@ 3600 IN MX 10 mail.example.com.
9	@ 3600 IN MX 20 example.com.
10	@ 3600 IN TXT "v=spf1 include:_spf.example.net -all"
11	_acme 30 IN TXT "short-lived"
12	sub 86400 IN NS ns1.example.net.
